I'll enhance the error handling to cover more edge cases and make it more robust. Let's expand our parser.



```c
#include <limits.h>
#include <stdlib.h>
#include <unistd.h>

// Enhanced number validation
int is_valid_number(char *str)
{
    int i;
    int digits;

    i = 0;
    digits = 0;
    
    // Handle empty string
    if (!str || !str[0])
        return (0);
        
    // Handle negative numbers and plus sign
    if (str[i] == '-' || str[i] == '+')
        i++;
        
    // String can't be just a sign
    if (!str[i])
        return (0);
        
    // Check all characters are digits and count them
    while (str[i])
    {
        if (str[i] < '0' || str[i] > '9')
            return (0);
        digits++;
        i++;
    }
    
    // Prevent numbers with leading zeros (except single zero)
    if (digits > 1 && str[0] == '0')
        return (0);
    if (digits > 1 && str[0] == '-' && str[1] == '0')
        return (0);
    
    // Prevent numbers that are too long (to avoid overflow in conversion)
    if (digits > 11)
        return (0);
        
    return (1);
}

// Enhanced string to number conversion
int str_to_num(char *str, long *num)
{
    long    result;
    int     sign;
    int     i;
    int     digit_count;

    result = 0;
    sign = 1;
    i = 0;
    digit_count = 0;

    if (str[i] == '-')
    {
        sign = -1;
        i++;
    }
    else if (str[i] == '+')
        i++;

    while (str[i])
    {
        // Prevent integer overflow during calculation
        if (result > (INT_MAX - (str[i] - '0')) / 10)
            return (0);
            
        result = result * 10 + (str[i] - '0');
        digit_count++;
        i++;
    }

    result *= sign;
    
    // Final range check
    if (result > INT_MAX || result < INT_MIN)
        return (0);
        
    *num = result;
    return (1);
}

// Check for duplicates with enhanced tracking
int has_duplicate(t_stack *stack, int value)
{
    t_node *current;
    int count;

    current = stack->top;
    count = 0;
    
    while (current)
    {
        if (current->value == value)
            return (1);
        current = current->next;
        count++;
        
        // Safety check for corrupted linked list
        if (count > stack->size)
            return (1);
    }
    return (0);
}

// Check if stack is already sorted
int is_sorted(t_stack *stack)
{
    t_node *current;
    
    if (!stack || !stack->top)
        return (1);
        
    current = stack->top;
    while (current->next)
    {
        if (current->value > current->next->value)
            return (0);
        current = current->next;
    }
    return (1);
}

// Enhanced whitespace checking
int is_only_spaces(char *str)
{
    int i;

    i = 0;
    while (str[i])
    {
        if (str[i] != ' ' && str[i] != '\t' && str[i] != '\n' && 
            str[i] != '\v' && str[i] != '\f' && str[i] != '\r')
            return (0);
        i++;
    }
    return (1);
}

// Enhanced argument parsing
int parse_args(t_stack *stack_a, int argc, char **argv)
{
    int     i;
    long    num;
    char    **split;
    int     j;
    int     found_numbers;

    i = 1;
    found_numbers = 0;
    
    while (i < argc)
    {
        // Skip empty arguments
        if (!argv[i][0])
            return (0);
            
        // Check for arguments that are only spaces
        if (is_only_spaces(argv[i]))
            return (0);
            
        // Handle space-separated numbers
        if (strchr(argv[i], ' '))
        {
            split = ft_split(argv[i], ' ');
            if (!split)
                return (0);
                
            j = 0;
            while (split[j])
            {
                if (!is_valid_number(split[j]) || !str_to_num(split[j], &num))
                {
                    free_split(split);
                    return (0);
                }
                if (has_duplicate(stack_a, (int)num))
                {
                    free_split(split);
                    return (0);
                }
                if (!push(stack_a, (int)num))
                {
                    free_split(split);
                    return (0);
                }
                found_numbers = 1;
                j++;
            }
            free_split(split);
        }
        else
        {
            if (!is_valid_number(argv[i]) || !str_to_num(argv[i], &num))
                return (0);
            if (has_duplicate(stack_a, (int)num))
                return (0);
            if (!push(stack_a, (int)num))
                return (0);
            found_numbers = 1;
        }
        i++;
    }
    
    // Check if we found any valid numbers
    return (found_numbers);
}

// Enhanced input handling wrapper
int handle_input(t_stack *stack_a, int argc, char **argv)
{
    // Check for no arguments
    if (argc < 2)
        return (0);
        
    // Check for NULL arguments
    if (!argv || !argv[1])
        return (0);
        
    // Parse and handle errors
    if (!parse_args(stack_a, argc, argv))
    {
        write(2, "Error\n", 6);
        free_stack(stack_a);
        return (0);
    }
    
    // Check if numbers need to be sorted
    if (is_sorted(stack_a) && stack_a->size > 0)
    {
        free_stack(stack_a);
        return (0);
    }
    
    return (1);
}

```

