./pipex file1 cmd1 cmd2 file2

File 1 can be nothing

cmd1 est effectuee, puis on applique cmd2 sur le resultat de cmd1 (par exemple grep affiche dans le terminal, on peut compter le nombre de mots "ecrits" par grep dans le terminal avec wc -w)


/* pipex.c */
#include "pipex.h"

void    handle_error(char *msg)
{
    perror(msg);
    exit(1);
}

void    execute_command(char *cmd, char **env)
{
    char **command;
    char *path;
    char *full_path;
    char **paths;
    int i;

    command = split_command(cmd);
    if (!command[0])
        handle_error("Command error");
        
    // Get PATH from environment
    path = getenv("PATH");
    paths = split_command(path);
    
    // Try each path
    i = 0;
    while (paths[i])
    {
        full_path = malloc(strlen(paths[i]) + strlen(command[0]) + 2);
        if (!full_path)
            handle_error("Malloc error");
        strcpy(full_path, paths[i]);
        strcat(full_path, "/");
        strcat(full_path, command[0]);
        
        if (access(full_path, X_OK) == 0)
        {
            execve(full_path, command, env);
            free(full_path);
            break;
        }
        free(full_path);
        i++;
    }
    handle_error("Command not found");
}

int main(int argc, char **argv, char **env)
{
    int     pipe_fd[2];
    pid_t   pid1;
    pid_t   pid2;
    int     infile;
    int     outfile;

    if (argc != 5)
        handle_error("Usage: ./pipex infile cmd1 cmd2 outfile");

    // Open files
    infile = open(argv[1], O_RDONLY);
    if (infile == -1)
        handle_error("Infile error");
    outfile = open(argv[4], O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (outfile == -1)
        handle_error("Outfile error");

    // Create pipe
    if (pipe(pipe_fd) == -1)
        handle_error("Pipe error");

    // First child process
    pid1 = fork();
    if (pid1 == -1)
        handle_error("Fork error");
    
    if (pid1 == 0)
    {
        // Child 1 process
        close(pipe_fd[0]);  // Close read end
        dup2(infile, STDIN_FILENO);
        dup2(pipe_fd[1], STDOUT_FILENO);
        close(pipe_fd[1]);
        close(infile);
        execute_command(argv[2], env);
    }

    // Second child process
    pid2 = fork();
    if (pid2 == -1)
        handle_error("Fork error");

    if (pid2 == 0)
    {
        // Child 2 process
        close(pipe_fd[1]);  // Close write end
        dup2(pipe_fd[0], STDIN_FILENO);
        dup2(outfile, STDOUT_FILENO);
        close(pipe_fd[0]);
        close(outfile);
        execute_command(argv[3], env);
    }

    // Parent process
    close(pipe_fd[0]);
    close(pipe_fd[1]);
    waitpid(pid1, NULL, 0);
    waitpid(pid2, NULL, 0);
    
    close(infile);
    close(outfile);
    return (0);
}
